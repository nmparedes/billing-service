NODE_ENV=development
PORT=3000
SERVICE_NAME=billing-service
SERVICE_VERSION=0.1.0
LOG_LEVEL=info
LOG_FORMAT=json
JWT_SECRET=change-me-with-a-secret-from-your-secret-manager
JWT_ISSUER=fiap-tech-challenge-auth-function
JWT_AUDIENCE=fiap-tech-challenge-api
JWT_REQUIRED_CUSTOMER_STATUS=ACTIVE
MONGODB_URI=mongodb://localhost:27017/billing
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
METRICS_ENABLED=true
MESSAGING_ENABLED=false
RABBITMQ_URL=amqp://replace-with-broker-credentials@localhost:5672
RABBITMQ_MAX_RETRIES=3
CONSUMED_MESSAGE_LEASE_MS=300000
PAYMENT_REFUND_LEASE_MS=300000
MERCADO_PAGO_ENVIRONMENT=test
MERCADO_PAGO_TEST_ACCESS_TOKEN=replace-with-a-test-access-token-from-your-secret-manager
MERCADO_PAGO_PRODUCTION_ACCESS_TOKEN=replace-with-a-production-access-token-from-your-secret-manager
MERCADO_PAGO_TEST_WEBHOOK_SECRET=replace-with-a-test-webhook-secret-from-your-secret-manager
MERCADO_PAGO_PRODUCTION_WEBHOOK_SECRET=replace-with-a-production-webhook-secret-from-your-secret-manager
MERCADO_PAGO_NOTIFICATION_URL=https://example.test/webhooks/mercado-pago
MERCADO_PAGO_SUCCESS_URL=https://example.test/payments/success
MERCADO_PAGO_FAILURE_URL=https://example.test/payments/failure
MERCADO_PAGO_PENDING_URL=https://example.test/payments/pending
